# Unidade systemd do hubd dentro da VM. Instalada por vm/provisionar.sh (troca @USER@).
[Unit]
Description=Assistente hubd
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Environment=HOME=/home/@USER@
# Sessões tmux herdam este PATH: claude, opencode e ai-memory moram em ~/.local/bin.
Environment=PATH=/home/@USER@/.local/bin:/usr/local/bin:/usr/bin:/bin
# Caminho absoluto: em serviço de sistema o %h é o home do root, não o do User= (203/EXEC).
ExecStart=/home/@USER@/.assistente/versoes/atual/hubd --config /home/@USER@/.config/assistente/assistente.toml
Restart=always
# O servidor tmux (com as sessões dos agentes) nasce como filho do hubd: só o hubd reinicia,
# as sessões continuam (F1.4).
KillMode=process
RestartSec=3

[Install]
WantedBy=multi-user.target
