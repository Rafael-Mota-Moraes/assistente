# Unidade systemd do hubd dentro da VM. Instalada por vm/provisionar.sh (troca @USER@).
[Unit]
Description=Assistente hubd
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Environment=HOME=/home/@USER@
ExecStart=/usr/local/bin/hubd --config /home/@USER@/.config/assistente/assistente.toml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
