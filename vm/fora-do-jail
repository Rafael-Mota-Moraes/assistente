#!/usr/bin/env bash
# fora-do-jail — pede ao Assistente para rodar um comando FORA do ai-jail, na VM (F9.6).
# Você aprova (ou nega) no app; a saída e o código de saída voltam para quem chamou.
#
#   fora-do-jail [--pc] [--timeout SEG] [--sem-esperar] [--] '<comando>'
#   fora-do-jail --resultado <id>
#   fora-do-jail diagnostico <comando-de-diagnostico>
#
# Com `--pc` (F9.9) o pedido vai para o PC: o hubd nunca o roda na VM; com sua aprovação, o
# app roda no seu computador, na mesma pasta do projeto (o caminho do PC, via virtiofs).
#
# Roda na pasta atual (precisa ser dentro do projeto), com o env do perfil. Códigos de saída:
# o do comando; 126 negado; 124 ninguém respondeu a tempo ou o comando estourou o timeout;
# 125 o pedido se perdeu (hubd reiniciou) ou falhou ao iniciar; 2 uso errado / fora de sessão.
# O `diagnostico` é leitura só (F14.1): não passa pelo app, devolve a saída e o código do
# comando de leitura.
# Spec: docs/specs/05-sandbox.md ("Fora do jail"); quadro e trabalhadores: docs/specs/10-kanban-e-trabalhadores.md
set -euo pipefail

die() { echo "fora-do-jail: $*" >&2; exit "${CODE:-2}"; }
uso() { sed -n '5,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# Quadro do projeto (F11.2): `fora-do-jail kanban pull|done|release|bloquear|validar|reabrir|trabalhador`. Não passa pelo
# app: é coordenação entre sessões (o que vai ao PC pede aprovação; isto não roda nada). Saída:
# o JSON da resposta; erro, a mensagem do hubd no stderr e código 1 (2 = uso errado).
kanban() {
  local url="${ASSISTENTE_EXEC_URL:-}" token="${ASSISTENTE_EXEC_TOKEN:-}"
  if [ -z "$url" ] || [ -z "$token" ]; then
    die "fora de uma sessão do Assistente (sem ASSISTENTE_EXEC_URL/ASSISTENTE_EXEC_TOKEN)"
  fi
  local acao="${1:-}" id="" commit="" modelos="" titulo="" descricao="" tipo="" prioridade="" motivo="" branch="" nota="" depende_de=""
  [ $# -gt 0 ] && shift
  case "$acao" in
    pull|listar|criar) ;;
    done|release|bloquear|validar|reabrir|trabalhador)
      [ $# -gt 0 ] || die "$acao: falta o id da tarefa (ex.: T3)"
      id="$1"
      shift
      ;;
    *) uso_kanban ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --commit) [ $# -ge 2 ] || uso_kanban; commit="$2"; shift 2 ;;
      --modelos) [ $# -ge 2 ] || uso_kanban; modelos="$2"; shift 2 ;;
      --titulo) [ $# -ge 2 ] || uso_kanban; titulo="$2"; shift 2 ;;
      --descricao) [ $# -ge 2 ] || uso_kanban; descricao="$2"; shift 2 ;;
      --tipo) [ $# -ge 2 ] || uso_kanban; tipo="$2"; shift 2 ;;
      --prioridade) [ $# -ge 2 ] || uso_kanban; prioridade="$2"; shift 2 ;;
      --motivo) [ $# -ge 2 ] || uso_kanban; motivo="$2"; shift 2 ;;
      --branch) [ $# -ge 2 ] || uso_kanban; branch="$2"; shift 2 ;;
      --nota) [ $# -ge 2 ] || uso_kanban; nota="$2"; shift 2 ;;
      --depende-de) [ $# -ge 2 ] || uso_kanban; depende_de="$2"; shift 2 ;;
      *) uso_kanban ;;
    esac
  done
  if [ "$acao" = criar ]; then
    [ -n "$titulo" ] || die "criar: informe --titulo"
  fi
  if [ "$acao" = validar ]; then
    [ -n "$branch" ] || die "validar: informe --branch (onde juntar, ex.: main)"
  fi
  if [ "$acao" = reabrir ]; then
    [ -n "$nota" ] || die "reabrir: informe --nota (o que falta)"
  fi
  local path method=POST body
  case "$acao" in
    pull) path=/v1/kanban/pull ;;
    listar) path=/v1/kanban; method=GET ;;
    criar) path=/v1/kanban/criar ;;
    done) path=/v1/kanban/done ;;
    release) path=/v1/kanban/release ;;
    bloquear) path=/v1/kanban/block ;;
    validar) path=/v1/kanban/validate ;;
    reabrir) path=/v1/kanban/reopen ;;
    trabalhador)
      path=/v1/workers
      ;;
  esac
  body="$(python3 -c '
import json, sys
acao, task, commit, modelos, titulo, descricao, tipo, prioridade, motivo, branch, nota, depende_de = sys.argv[1:13]
if acao == "done":
    body = {"id": task, "commit": commit or None}
elif acao == "release":
    body = {"id": task}
elif acao == "bloquear":
    body = {"id": task, "reason": motivo}
elif acao == "validar":
    body = {"id": task, "branch": branch}
elif acao == "reabrir":
    body = {"id": task, "note": nota}
elif acao == "trabalhador":
    body = {"task": task, "models": [m for m in modelos.split(",") if m]}
elif acao == "criar":
    body = {"title": titulo}
    if descricao:
        body["description"] = descricao
    if tipo:
        body["kind"] = tipo
    if prioridade:
        body["priority"] = prioridade
    if depende_de:
        body["depends_on"] = [d.strip() for d in depende_de.split(",") if d.strip()]
else:
    body = {}
print(json.dumps(body))' "$acao" "$id" "$commit" "$modelos" "$titulo" "$descricao" "$tipo" "$prioridade" "$motivo" "$branch" "$nota" "$depende_de")"
  local response status json
  if [ "$method" = GET ]; then
    response="$(curl -sS --noproxy '*' -m 60 -w '\n%{http_code}' \
      -H "Authorization: Bearer $token" "$url$path")" || die "o hubd não respondeu em $url"
  else
    response="$(curl -sS --noproxy '*' -m 60 -w '\n%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data-binary "$body" "$url$path")" || die "o hubd não respondeu em $url"
  fi
  status="${response##*$'\n'}"
  json="${response%$'\n'*}"
  case "$status" in
    200|201) echo "$json"; exit 0 ;;
    401) CODE=1 die "token recusado: a sessão foi encerrada?" ;;
    *) CODE=1 die "HTTP $status: $(python3 -c 'import json, sys
try:
    print(json.loads(sys.argv[1]).get("error", sys.argv[1]))
except ValueError:
    print(sys.argv[1])' "$json")" ;;
  esac
}
uso_kanban() {
  echo "uso: fora-do-jail kanban listar | criar --titulo T [--descricao D] [--tipo manual|agente] [--prioridade alta|normal|baixa] [--depende-de T1,T3]" >&2
  echo "     fora-do-jail kanban pull | done <id> [--commit SHA] | release <id> | trabalhador <id> [--modelos m1,m2]" >&2
  echo "     fora-do-jail kanban bloquear <id> --motivo M   (cota esgotada: pausa o orquestrador)" >&2
  echo "     fora-do-jail kanban validar <id> --branch B | reabrir <id> --nota N   (QA de um card feito)" >&2
  exit 2
}

# Diagnóstico da VM (F14.1): `fora-do-jail diagnostico <comando>`. Leitura só (journal do hubd,
# sessões do tmux, saída de uma sessão, prompts do quadro, login do Claude): não passa pelo app
# e não escreve nada. A saída vem no stdout; o que o comando reclamou, no stderr.
diagnostico() {
  local url="${ASSISTENTE_EXEC_URL:-}" token="${ASSISTENTE_EXEC_TOKEN:-}"
  if [ -z "$url" ] || [ -z "$token" ]; then
    die "fora de uma sessão do Assistente (sem ASSISTENTE_EXEC_URL/ASSISTENTE_EXEC_TOKEN)"
  fi
  [ $# -gt 0 ] || die "diagnostico: falta o comando (journal-hubd | tmux-ls | tmux-pane <sessão> | explorar | claude-login)"
  local body response status json
  body="$(python3 -c 'import json, sys; print(json.dumps({"comando": " ".join(sys.argv[1:])}))' "$@")"
  response="$(curl -sS --noproxy '*' -m 60 -w '\n%{http_code}' \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    --data-binary "$body" "$url/v1/diagnostico")" || die "o hubd não respondeu em $url"
  status="${response##*$'\n'}"
  json="${response%$'\n'*}"
  case "$status" in
    200) ;;
    401) CODE=1 die "token recusado: a sessão foi encerrada?" ;;
    *) CODE=1 die "HTTP $status: $(python3 -c 'import json, sys
try:
    print(json.loads(sys.argv[1]).get("error", sys.argv[1]))
except ValueError:
    print(sys.argv[1])' "$json")" ;;
  esac
  local rc=0
  python3 -c '
import json, sys
reply = json.loads(sys.argv[1])
sys.stdout.write(reply.get("saida") or "")
sys.stdout.flush()
erro = reply.get("erro")
if erro:
    sys.stderr.write(erro if erro.endswith("\n") else erro + "\n")
if reply.get("truncado"):
    print("fora-do-jail: saída grande; só o fim foi guardado.", file=sys.stderr)
code = reply.get("codigo")
sys.exit(code if isinstance(code, int) and code else 0)' "$json" || rc=$?
  exit "$rc"
}

if [ "${1:-}" = kanban ]; then
  shift
  kanban "$@"
fi

if [ "${1:-}" = diagnostico ]; then
  shift
  diagnostico "$@"
fi

timeout=""
wait=1
id=""
pc=""
while [ $# -gt 0 ]; do
  case "$1" in
    --timeout) [ $# -ge 2 ] || uso; timeout="$2"; shift 2 ;;
    --sem-esperar) wait=0; shift ;;
    --pc) pc=1; shift ;;
    --resultado) [ $# -ge 2 ] || uso; id="$2"; shift 2 ;;
    -h|--help) uso ;;
    --) shift; break ;;
    -*) die "opção desconhecida: $1" ;;
    *) break ;;
  esac
done
command="$*"
[ -n "$id" ] || [ -n "$command" ] || uso
case "$timeout" in ''|*[!0-9]*) [ -z "$timeout" ] || die "--timeout espera segundos" ;; esac

url="${ASSISTENTE_EXEC_URL:-}"
token="${ASSISTENTE_EXEC_TOKEN:-}"
if [ -z "$url" ] || [ -z "$token" ]; then
  die "fora de uma sessão do Assistente (sem ASSISTENTE_EXEC_URL/ASSISTENTE_EXEC_TOKEN)"
fi

# Saída: corpo, uma linha em branco e o status HTTP na última linha. O proxy do jail não
# conhece o hubd: tudo direto em 127.0.0.1.
http() { # <max-time> <curl args…>
  local max="$1"
  shift
  curl -sS --noproxy '*' -m "$max" -w '\n%{http_code}' \
    -H "Authorization: Bearer $token" "$@"
}

field() { # <json> <campo>
  python3 -c 'import json, sys; v = json.loads(sys.argv[1]).get(sys.argv[2]); print("" if v is None else v)' "$1" "$2"
}

if [ -z "$id" ]; then
  body="$(python3 -c '
import json, os, sys
request = {"command": sys.argv[1], "cwd": os.getcwd()}
if sys.argv[2]:
    request["timeout_secs"] = int(sys.argv[2])
if sys.argv[3]:
    request["target"] = "host"
print(json.dumps(request))' "$command" "$timeout" "$pc")"
  response="$(http 30 -H 'Content-Type: application/json' --data-binary "$body" "$url/v1/exec")" \
    || CODE=125 die "o hubd não respondeu em $url"
  status="${response##*$'\n'}"
  json="${response%$'\n'*}"
  case "$status" in
    202) ;;
    401) die "token recusado: a sessão foi encerrada?" ;;
    429) CODE=125 die "pedidos demais esperando aprovação; espere uma resposta no app" ;;
    *) die "pedido recusado (HTTP $status): $(field "$json" error 2>/dev/null || echo "$json")" ;;
  esac
  id="$(field "$json" id)"
  if [ "$(field "$json" auto_approved)" = "True" ]; then
    echo "fora-do-jail: pedido $id sempre permitido neste projeto; rodando…" >&2
  elif [ -n "$pc" ]; then
    echo "fora-do-jail: pedido $id aguardando aprovação no app; vai rodar no seu PC…" >&2
  else
    echo "fora-do-jail: pedido $id aguardando aprovação no app do Assistente…" >&2
  fi
  if [ "$wait" -eq 0 ]; then
    echo "$id"
    exit 0
  fi
fi

while :; do
  response="$(http 60 "$url/v1/exec/$id?wait=50")" \
    || CODE=125 die "pedido $id perdido (o hubd reiniciou?); peça de novo"
  status="${response##*$'\n'}"
  json="${response%$'\n'*}"
  case "$status" in
    200) ;;
    404) CODE=125 die "pedido $id perdido (o hubd reiniciou?); peça de novo" ;;
    401) die "token recusado: a sessão foi encerrada?" ;;
    *) CODE=125 die "erro esperando o pedido $id (HTTP $status)" ;;
  esac
  case "$(field "$json" state)" in
    pending|running) continue ;;
  esac
  # Estado final: repassa saída e código como se o comando tivesse rodado aqui.
  rc=0
  python3 -c '
import json, sys
view = json.loads(sys.argv[1])
state, result = view["state"], view.get("result") or {}
def note(text):
    print(f"fora-do-jail: {text}", file=sys.stderr)
if state == "denied":
    note("negado pelo usuário no app. Não tente de outro jeito; pergunte o que fazer.")
    sys.exit(126)
if state == "expired":
    note("ninguém respondeu a tempo no app; peça de novo se ainda precisar.")
    sys.exit(124)
sys.stdout.write(result.get("stdout") or "")
sys.stdout.flush()
sys.stderr.write(result.get("stderr") or "")
if result.get("truncated"):
    note("saída grande: só o fim foi guardado.")
if state == "failed":
    note("não consegui rodar o comando fora do jail.")
    sys.exit(125)
if result.get("timed_out"):
    note("o comando estourou o timeout e foi encerrado.")
    sys.exit(124)
code = result.get("exit_code")
sys.exit(code if code is not None else 125)' "$json" || rc=$?
  exit "$rc"
done
