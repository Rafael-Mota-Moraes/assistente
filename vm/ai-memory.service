# Serviço systemd --user do ai-memory na VM (F5.0). Instalado por vm/provisionar.sh.
[Unit]
Description=ai-memory (servidor local do Assistente)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=AI_MEMORY_DATA_DIR=@MIRROR@
ExecStart=@HOME@/.local/bin/ai-memory serve --transport http --bind 127.0.0.1:@PORT@ --enable-api --enable-web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
