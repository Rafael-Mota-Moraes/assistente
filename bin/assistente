#!/usr/bin/env bash
# CLI do host para o Assistente (a VM, backups e o notebook). O app Tauri cobre o dia a dia.
#   assistente vm criar|provisionar|iniciar|parar|shell|recriar|logins|status
#   assistente login claude|opencode <perfil>   login do agente dentro da VM, por perfil
#   assistente token                            gera ~/.config/assistente/hub.token
#   assistente backup [--sem-logins] [arq.tar.gz]  config + espelho da memória + logins da VM
#   assistente restaurar <arquivo.tar.gz>
#   assistente notebook instalar                copia notebook/ e roda o instalar.sh por SSH
#   assistente agentes configurar               9router no opencode + ai-memory nos agentes da VM
#   assistente atualizar                        hubd novo na VM + app recompilado e reinstalado  (ou ./atualizar.sh)
# TESTADO SEM VM: `token`, leitura da config e backup/restaurar (incus falso, F7.1).
# VM = F1, notebook = F4. Spec: docs/specs/01-vm-e-instalacao.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF_DIR="$HOME/.config/assistente"
CONF="$CONF_DIR/assistente.toml"
NET="assistente0"
NET_CIDR="10.77.0.1/24"
# Logins da VM vindos de um backup (`assistente restaurar`), à espera do próximo `vm criar`
# ou de um `vm logins`. Consumido (apagado) depois de copiado para a VM.
RESTORE_LOGINS_DIR="$HOME/.local/share/assistente/restauracao/perfis"
# Configurações dos projetos (engrenagem, F9.4): mesmo ciclo dos logins.
RESTORE_PROJECTS_FILE="$HOME/.local/share/assistente/restauracao/projetos.toml"
TMP_DIR=""

die() { echo "assistente: $*" >&2; exit 1; }
cleanup() { if [ -n "$TMP_DIR" ]; then rm -rf "$TMP_DIR"; fi; }
trap cleanup EXIT

# Quem acabou de entrar no grupo incus-admin só o ganha na sessão depois de logout/login; até
# lá o socket do incus nega acesso. Nesse caso roda de novo via sg.
INCUS_SOCK="/var/lib/incus/unix.socket"
if command -v incus >/dev/null && [ -S "$INCUS_SOCK" ] && [ ! -w "$INCUS_SOCK" ]; then
  [[ " $(id -nG "$USER") " == *" incus-admin "* ]] \
    || die "sem permissão no incus: sudo usermod -aG incus-admin $USER e faça logout/login"
  [ -z "${ASSISTENTE_SG:-}" ] || die "sem permissão no incus mesmo via sg incus-admin"
  echo "assistente: sessão sem o grupo incus-admin (falta logout/login); rodando via sg por agora" >&2
  export ASSISTENTE_SG=1
  exec sg incus-admin -c "$(printf '%q ' "$0" "$@")"
fi

# Lê uma chave da config: cfg vm.name
cfg() {
  [ -f "$CONF" ] || die "sem $CONF (rode ./instalar.sh)"
  python3 - "$CONF" "$1" <<'PY'
import sys, tomllib
value = tomllib.load(open(sys.argv[1], "rb"))
for part in sys.argv[2].split("."):
    value = value[part]
print(" ".join(value) if isinstance(value, list) else value)
PY
}

profile_roots() {
  python3 - "$CONF" <<'PY'
import sys, tomllib, os
for p in tomllib.load(open(sys.argv[1], "rb"))["profiles"].values():
    print(os.path.expanduser(p["root"]))
PY
}

vm_criar() {
  local name ip
  name="$(cfg vm.name)"
  ip="$(cfg vm.ip)"
  incus info "$name" >/dev/null 2>&1 && die "VM $name já existe (use: vm recriar)"

  incus network show "$NET" >/dev/null 2>&1 \
    || incus network create "$NET" ipv4.address="$NET_CIDR" ipv4.nat=true ipv6.address=none

  local userdata
  userdata="$(sed -e "s/@USER@/$(id -un)/g" -e "s/@UID@/$(id -u)/g" -e "s/@GID@/$(id -g "$(id -un)")/g" "$ROOT/vm/cloud-init.yaml")"
  incus init "$(cfg vm.image)" "$name" --vm \
    -c limits.cpu="$(cfg vm.cpus)" -c limits.memory="$(cfg vm.memory)" \
    -c cloud-init.user-data="$userdata" \
    -d root,size="$(cfg vm.disk)" \
    -n "$NET"
  incus config device set "$name" eth0 ipv4.address="$ip" 2>/dev/null \
    || incus config device override "$name" eth0 ipv4.address="$ip"

  # Mesmo caminho dos dois lados. Config só leitura; espelho da memória gravável.
  local i=0 root
  while read -r root; do
    mkdir -p "$root"
    incus config device add "$name" "perfil$i" disk source="$root" path="$root"
    i=$((i + 1))
  done < <(profile_roots)
  incus config device add "$name" config disk source="$CONF_DIR" path="$CONF_DIR" readonly=true
  local mirror
  mirror="$(cfg memory.mirror_dir | sed "s|^~|$HOME|")"
  mkdir -p "$mirror"
  incus config device add "$name" memoria disk source="$mirror" path="$mirror"

  incus start "$name"
  vm_provisionar
  # Logins que vieram de um backup (`assistente restaurar`) entram agora, depois do
  # provisionamento para não serem sobrescritos.
  vm_push_logins
}

# Liga a VM se estiver parada e espera o incus-agent responder (logo após o start ele ainda
# não subiu).
vm_esperar_agente() {
  local name="$1" i err=""
  if [ "$(incus list "^$name\$" -c s -f csv)" = "STOPPED" ]; then
    echo "VM $name parada; ligando..."
    incus start "$name"
  fi
  for i in $(seq 1 90); do
    err="$(incus exec "$name" -- true 2>&1)" && return 0
    sleep 2
  done
  die "o agente da VM $name não respondeu em 3 min${err:+: $err}"
}

# Reexecutável: compila o hubd e roda vm/provisionar.sh na VM já criada.
vm_provisionar() {
  local name
  name="$(cfg vm.name)"
  echo "Esperando a VM e o cloud-init..."
  vm_esperar_agente "$name"
  # 0 = ok, 2 = concluído com avisos recuperáveis; o resto é falha.
  local rc=0
  incus exec "$name" -- cloud-init status --wait >/dev/null || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    die "cloud-init falhou (rc=$rc): incus exec $name -- cloud-init status --long"
  fi
  [ "$rc" -eq 2 ] && echo "cloud-init com avisos: incus exec $name -- cloud-init schema --system"
  # Os agentes rodam ./dev na VM e os volumes Docker de build (target do Cargo) enchem o disco;
  # sem esta checagem o push abaixo falha só com "sftp: no space left on device". O
  # limpar-disco.timer (F1.7) evita chegar aqui; isto cobre a VM provisionada antes dele.
  local livre_mb
  livre_mb="$(incus exec "$name" -- df --output=avail -m / | tail -1 | tr -d ' ')"
  [ "$livre_mb" -ge 1024 ] \
    || die "disco da VM quase cheio (${livre_mb} MB livres); libere com: incus exec $name -- docker volume prune -a -f"

  echo "Compilando o hubd (container ./dev)..."
  "$ROOT/dev" just build-hubd
  incus exec "$name" -- mkdir -p /tmp/assistente
  incus file push -q "$ROOT/target/release/hubd" "$name/tmp/assistente/hubd"
  incus file push -q "$ROOT/vm/hubd.service" "$name/tmp/assistente/hubd.service"
  incus file push -q "$ROOT/vm/provisionar.sh" "$name/tmp/assistente/provisionar.sh"
  incus file push -q "$ROOT/vm/ai-memory.service" "$name/tmp/assistente/ai-memory.service"
  incus file push -q "$ROOT/vm/fora-do-jail" "$name/tmp/assistente/fora-do-jail"
  incus file push -q "$ROOT/vm/trabalhador" "$name/tmp/assistente/trabalhador"
  incus file push -q "$ROOT/vm/limpar-disco" "$name/tmp/assistente/limpar-disco"
  # O atualizador (F8.5) precisa do repo com git: manda um bundle com os commits e a VM clona.
  local bundle_dir
  bundle_dir="$(mktemp -d)"
  git -C "$ROOT" bundle create -q "$bundle_dir/repo.bundle" --all
  incus file push -q "$bundle_dir/repo.bundle" "$name/tmp/assistente/repo.bundle"
  rm -rf "$bundle_dir"
  incus exec "$name" -- bash /tmp/assistente/provisionar.sh "$(id -un)"
  echo "VM pronta. Próximo: assistente login claude pessoal"
}

cmd_vm() {
  local name
  name="$(cfg vm.name)"
  case "${1:-status}" in
    criar) vm_criar ;;
    provisionar) vm_provisionar ;;
    iniciar) incus start "$name" ;;
    parar) incus stop "$name" ;;
    shell) incus exec "$name" -- sudo -u "$(id -un)" -i ;;
    logins)
      [ -d "$RESTORE_LOGINS_DIR" ] || [ -f "$RESTORE_PROJECTS_FILE" ] \
        || die "nada para copiar: rode 'assistente restaurar <backup.tar.gz>' antes"
      vm_push_logins
      ;;
    recriar)
      read -r -p "Apagar a VM $name e criar de novo? Os logins atuais são preservados automaticamente. [s/N] " ok
      [ "$ok" = "s" ] || exit 1
      # Preserva os logins (e as configurações dos projetos) da VM atual antes de
      # apagá-la, para que `vm_criar` os restaure (F7.3). Se a VM estiver parada
      # ou ausente, segue sem preservar (nada a puxar).
      if incus info "$name" >/dev/null 2>&1; then
        if [ "$(incus list "^$name\$" -c s -f csv 2>/dev/null)" = "RUNNING" ]; then
          local stage=""
          stage="$(mktemp -d)"
          TMP_DIR="$stage"
          if vm_pull_logins "$stage" >/dev/null 2>&1; then
            if [ -d "$stage/vm-perfis" ]; then
              rm -rf "$RESTORE_LOGINS_DIR"
              mkdir -p "$RESTORE_LOGINS_DIR"
              cp -a "$stage/vm-perfis/." "$RESTORE_LOGINS_DIR/"
            fi
            if [ -f "$stage/vm-projetos.toml" ]; then
              mkdir -p "$(dirname "$RESTORE_PROJECTS_FILE")"
              (umask 077; cp "$stage/vm-projetos.toml" "$RESTORE_PROJECTS_FILE")
            fi
          fi
          TMP_DIR=""
          rm -rf "$stage"
        fi
        incus delete --force "$name"
      fi
      vm_criar
      ;;
    status) incus list "^$name\$" ;;
    *) die "uso: assistente vm criar|provisionar|iniciar|parar|shell|recriar|logins|status" ;;
  esac
}

cmd_login() {
  local agent="${1:-}" profile="${2:-}"
  if [ -z "$agent" ] || [ -z "$profile" ]; then die "uso: assistente login claude|opencode <perfil>"; fi
  local data
  data="/home/$(id -un)/.assistente/perfis/$profile"
  case "$agent" in
    claude) incus exec "$(cfg vm.name)" -- sudo -u "$(id -un)" -i env CLAUDE_CONFIG_DIR="$data/claude" claude /login ;;
    opencode) incus exec "$(cfg vm.name)" -- sudo -u "$(id -un)" -i env OPENCODE_CONFIG="$data/opencode/opencode.json" opencode auth login ;;
    *) die "agente desconhecido: $agent" ;;
  esac
}

cmd_token() {
  mkdir -p "$CONF_DIR"
  local file
  file="$(cfg hub.token_file | sed "s|^~|$HOME|")"
  [ -s "$file" ] && { echo "token já existe em $file"; return; }
  (umask 077; head -c 32 /dev/urandom | base64 | tr -d '/+=' > "$file")
  echo "token gerado em $file"
}

# Copia ~/.assistente/perfis da VM (logins dos agentes) para <destino>/vm-perfis e as
# configurações dos projetos (~/.assistente/projetos.toml, F9.4) para <destino>/vm-projetos.toml.
vm_pull_logins() {
  local dest="$1" name path projects
  name="$(cfg vm.name)"
  path="/home/$(id -un)/.assistente/perfis"
  projects="/home/$(id -un)/.assistente/projetos.toml"

  incus info "$name" >/dev/null 2>&1 \
    || die "VM $name não existe: sem logins para copiar (use --sem-logins para um backup parcial)"
  [ "$(incus list "^$name\$" -c s -f csv)" = "RUNNING" ] \
    || die "VM $name parada: ligue (assistente vm iniciar) para incluir os logins, ou use --sem-logins"
  incus exec "$name" -- true 2>/dev/null \
    || die "o agente da VM $name ainda não responde; tente de novo em instantes"
  if incus exec "$name" -- test -f "$projects"; then
    (umask 077; incus exec "$name" -- cat "$projects" >"$dest/vm-projetos.toml")
  fi
  if ! incus exec "$name" -- test -d "$path"; then
    echo "assistente: $path ainda não existe na VM; backup sem logins" >&2
    return 0
  fi

  mkdir -p "$dest/vm-perfis"
  # tar pelo stdin/stdout do incus: preserva dono e modo e não depende do estado do destino.
  incus exec "$name" -- tar -czf - -C "/home/$(id -un)/.assistente" perfis \
    | tar -xzf - -C "$dest/vm-perfis" --strip-components=1
}

# Copia os logins (e as configurações dos projetos) restaurados do backup para a VM.
# Silencioso quando não há nada pendente.
vm_push_logins() {
  local name path projects
  name="$(cfg vm.name)"
  path="/home/$(id -un)/.assistente/perfis"
  projects="/home/$(id -un)/.assistente/projetos.toml"

  if [ -f "$RESTORE_PROJECTS_FILE" ]; then
    echo "==> configurações dos projetos restauradas do backup"
    incus exec "$name" -- sudo -u "$(id -un)" -i mkdir -p "$(dirname "$projects")"
    incus exec "$name" -- tee "$projects" >/dev/null <"$RESTORE_PROJECTS_FILE"
    incus exec "$name" -- chown "$(id -un):" "$projects"
    incus exec "$name" -- chmod 600 "$projects"
    rm -f "$RESTORE_PROJECTS_FILE"
    echo "    $projects"
  fi
  [ -d "$RESTORE_LOGINS_DIR" ] || return 0

  echo "==> logins restaurados do backup"
  incus exec "$name" -- sudo -u "$(id -un)" -i mkdir -p "$path"
  tar -czf - -C "$RESTORE_LOGINS_DIR" . | incus exec "$name" -- tar -xzf - -C "$path"
  incus exec "$name" -- chown -R "$(id -un):" "$path"
  rm -rf "$RESTORE_LOGINS_DIR"
  echo "    $path"
}

cmd_backup() {
  local with_logins=1 out="" arg
  for arg in "$@"; do
    case "$arg" in
      --sem-logins) with_logins=0 ;;
      -h|--help) die "uso: assistente backup [--sem-logins] [arquivo.tar.gz]" ;;
      -*) die "opção desconhecida: $arg (uso: assistente backup [--sem-logins] [arquivo.tar.gz])" ;;
      *) [ -z "$out" ] || die "argumento sobrando: $arg"; out="$arg" ;;
    esac
  done
  out="${out:-$HOME/assistente-backup-$(date +%F).tar.gz}"

  local mirror
  mirror="$(cfg memory.mirror_dir | sed "s|^~|$HOME|")"
  [ -d "$mirror" ] || die "espelho da memória não existe: $mirror"

  local stage
  stage="$(mktemp -d)"
  TMP_DIR="$stage"

  if [ "$with_logins" -eq 1 ]; then
    vm_pull_logins "$stage"
  fi
  # GNU tar aceita mais de um -C; o layout do tar continua relativo a $HOME, e os logins da
  # VM entram em vm-perfis/ e vm-projetos.toml (extraídos à parte pelo `restaurar`).
  local tar_args=(-czf "$out" -C "$HOME" ".config/assistente" "${mirror#"$HOME"/}")
  local extras=()
  [ -d "$stage/vm-perfis" ] && extras+=(vm-perfis)
  [ -f "$stage/vm-projetos.toml" ] && extras+=(vm-projetos.toml)
  [ "${#extras[@]}" -gt 0 ] && tar_args+=(-C "$stage" "${extras[@]}")
  tar "${tar_args[@]}"
  echo "backup em $out"
}

cmd_restaurar() {
  local file="${1:?uso: assistente restaurar <arquivo.tar.gz>}" entries
  TMP_DIR="$(mktemp -d)"
  entries="$TMP_DIR/lista"
  tar -tzf "$file" >"$entries" || die "backup ilegível: $file"

  # Config e espelho voltam para o home; os logins da VM ficam à espera (não pertencem ao host).
  tar -xzf "$file" -C "$HOME" --exclude "vm-perfis" --exclude "vm-perfis/*" \
    --exclude "vm-projetos.toml"
  # O estado pendente é sempre o do backup restaurado agora (backup antigo não deixa resto).
  rm -rf "$RESTORE_LOGINS_DIR" "$RESTORE_PROJECTS_FILE"
  if grep -qx "vm-projetos.toml" "$entries"; then
    mkdir -p "$(dirname "$RESTORE_PROJECTS_FILE")"
    (umask 077; tar -xzOf "$file" vm-projetos.toml >"$RESTORE_PROJECTS_FILE")
    echo "configurações dos projetos restauradas; entram na VM junto com os logins"
  fi
  if grep -q "^vm-perfis/" "$entries"; then
    mkdir -p "$RESTORE_LOGINS_DIR"
    tar -xzf "$file" -C "$RESTORE_LOGINS_DIR" --strip-components=1 vm-perfis
    echo "logins da VM restaurados; entram na VM no próximo 'vm criar' (ou 'assistente vm logins')"
  fi
  echo "restaurado em $HOME (config e espelho da memória)"
}

cmd_notebook() {
  [ "${1:-}" = "instalar" ] || die "uso: assistente notebook instalar"
  local name alias target
  name="$(cfg vm.name)"
  alias="$(cfg notebook.ssh_host)"
  target="$(cfg notebook.user)@$(cfg notebook.address)"
  local in_vm=(incus exec "$name" -- sudo -u "$(id -un)" -i)

  echo "==> chave SSH e alias '$alias' na VM"
  "${in_vm[@]}" bash -c '[ -f ~/.ssh/id_ed25519 ] || ssh-keygen -q -t ed25519 -N "" -C assistente-vm -f ~/.ssh/id_ed25519'
  "${in_vm[@]}" bash -c "touch ~/.ssh/config && chmod 600 ~/.ssh/config && grep -q '^Host $alias\$' ~/.ssh/config || printf '%s\n' 'Host $alias' '  HostName $(cfg notebook.address)' '  User $(cfg notebook.user)' '  IdentityFile ~/.ssh/id_ed25519' '  ServerAliveInterval 15' '  ServerAliveCountMax 3' >> ~/.ssh/config"

  echo "==> autorizando a chave da VM no notebook ($target)"
  local pub
  pub="$("${in_vm[@]}" cat .ssh/id_ed25519.pub)"
  # shellcheck disable=SC2029 # $pub expande aqui de propósito
  ssh "$target" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && grep -qxF '$pub' ~/.ssh/authorized_keys || echo '$pub' >> ~/.ssh/authorized_keys"

  echo "==> setup do notebook (pede o sudo de lá)"
  scp -q -r "$ROOT/notebook" "$target:/tmp/assistente-notebook"
  ssh -t "$target" bash /tmp/assistente-notebook/instalar.sh

  echo "==> testando da VM"
  # shellcheck disable=SC2016 # $(hostname) roda no notebook
  "${in_vm[@]}" ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$alias" 'echo "VM -> notebook ok ($(hostname))"'
}

cmd_agentes() {
  [ "${1:-}" = "configurar" ] || die "uso: assistente agentes configurar"
  local name payload
  name="$(cfg vm.name)"
  # Providers + policies do opencode deste PC (um plano pago, por exemplo). Vão com as chaves
  # pelo stdin, para nada ficar gravado no /tmp da VM.
  payload="$(python3 - "$HOME/.config/opencode/opencode.json" <<'PY'
import json, os, sys
path = sys.argv[1]
config = json.load(open(path)) if os.path.exists(path) else {}
providers = config.get("provider", {})
policies = config.get("policies", [])
print(json.dumps({"provider": providers, "policies": policies}))
print(
    "Provedores do opencode do PC: %s · policies: %d"
    % (", ".join(providers) or "nenhum", len(policies)),
    file=sys.stderr,
)
PY
)"
  incus exec "$name" -- mkdir -p /tmp/assistente
  incus file push -q "$ROOT/vm/configurar-agentes.sh" "$name/tmp/assistente/configurar-agentes.sh"
  incus exec "$name" -- sudo -u "$(id -un)" -i bash /tmp/assistente/configurar-agentes.sh <<< "$payload"
}

# Depois de mudar o código: hubd na VM (as sessões tmux sobrevivem) e o app desktop.
cmd_atualizar() {
  echo "==> hubd na VM"
  vm_provisionar
  echo "==> app desktop"
  "$ROOT/dev" just build
  # Mesma versão (0.1.0) a cada build: sem --reinstall o apt acha que já está atualizado.
  sudo apt-get install -y --reinstall "$ROOT"/target/release/bundle/deb/assistente_*_amd64.deb
  echo "Atualizado. Feche e abra o Assistente."
}

case "${1:-}" in
  atualizar) cmd_atualizar ;;
  agentes) shift; cmd_agentes "$@" ;;
  vm) shift; cmd_vm "$@" ;;
  login) shift; cmd_login "$@" ;;
  token) cmd_token ;;
  backup) shift; cmd_backup "$@" ;;
  restaurar) shift; cmd_restaurar "$@" ;;
  notebook) shift; cmd_notebook "$@" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
